POSTGRES_DB=lumina
POSTGRES_USER=lumina
POSTGRES_PASSWORD=changeme
REDIS_PASSWORD=changeme
JWT_ACCESS_SECRET=changeme
JWT_REFRESH_SECRET=changeme
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
MAX_UPLOAD_MB=25
CORS_ORIGIN=https://lumina.luxffa.com,https://localhost,capacitor://localhost,app://bundle
NODE_ENV=production

# Platform staff (video feed review queue). Comma-separated emails, reconciled into
# User.isSiteAdmin on each login — add/remove here, then log in, to grant/revoke.
SITE_ADMIN_EMAILS=
# Video feed caps. MAX_VIDEO_UPLOAD_MB applies only to POST /api/videos (chat attachments stay
# capped by MAX_UPLOAD_MB above).
MAX_VIDEO_UPLOAD_MB=100
MAX_VIDEO_DURATION_SEC=180
MAX_VIDEO_UPLOADS_PER_DAY=10

# Platform authority ladder (USER < STAFF < OWNER), reconciled into User.platformRole on each
# login in both directions — add/remove here, then log in, to grant/revoke. OWNER wins if an
# address appears in both. SITE_ADMIN_EMAILS above is the old name for STAFF_EMAILS, still read.
OWNER_EMAILS=
STAFF_EMAILS=

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM_MONTHLY=

MASTER_EMAIL=

# ---- outbound mail (email verification) ----
# Leave blank to run without email: nothing is sent, verification simply never completes, and the
# app tells the user that rather than silently swallowing it.
# SMTP_SECURE is derived from the port (465 = implicit TLS) unless set explicitly.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=

# ---- backup encryption ----
# Backups are encrypted with this before being uploaded offsite. Leave blank to upload plaintext —
# the script says so loudly rather than silently. KEEP A COPY OFF THIS MACHINE: losing it makes
# every offsite backup unreadable, and the situation they exist for is this machine being gone.
BACKUP_ENCRYPTION_KEY=

# ---- values compose.yml builds for you --------------------------------------------------------
# DATABASE_URL, REDIS_URL, PORT, UPLOADS_DIR and TURN_PORT are assembled in compose.yml from the
# POSTGRES_*/REDIS_* values above. Set them here ONLY when running the backend outside Docker.

# ---- public origin ----------------------------------------------------------------------------
# Every absolute URL the server generates — verification links, Stripe success/cancel redirects,
# invite links. The first HTTPS entry is treated as canonical.
#
# The backend REFUSES TO START if NODE_ENV=production and this still looks like a dev value. That
# guard exists because a deploy once ran with localhost here and emailed unusable links; see
# config/env.ts.
PUBLIC_APP_URL=https://your-domain.example

# ---- voice/video relay (coturn) ---------------------------------------------------------------
# Without these, calls work only between peers that can reach each other directly — which excludes
# most people behind home routers. TURN_SECRET must match the static-auth-secret coturn is run with.
TURN_HOST=your-domain.example
TURN_SECRET=

# ---- web push ---------------------------------------------------------------------------------
# Generate once with: npx web-push generate-vapid-keys
# Absent = push notifications degrade to a no-op rather than erroring.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@your-domain.example

# ---- ops agent ---------------------------------------------------------------------------------
# Shared secret for Lumina Control's reporting endpoints. Compared in constant time; leave blank to
# disable those routes entirely.
OPS_AGENT_SECRET=

# ---- android ------------------------------------------------------------------------------------
# The build number installed clients compare themselves against to offer an update. deploy.sh bumps
# this on a full (non --web-only) deploy.
ANDROID_VERSION_CODE=1
