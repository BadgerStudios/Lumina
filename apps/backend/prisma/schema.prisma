generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PresenceStatus {
  ONLINE
  IDLE
  DND
  OFFLINE
}

enum ChannelType {
  TEXT
  CATEGORY
  // Voice channels carry no Message rows at all — presence/signaling is entirely ephemeral,
  // handled over Socket.IO (realtime/handlers/voice.ts), never persisted. A VOICE channel row
  // is just an addressable place to join, same as TEXT is just an addressable place to post.
  VOICE
  // A thread is a real Channel, not a parallel Thread/ThreadMessage pair. Every piece of message
  // infrastructure already built — send, edit, delete, reactions, pins, search, @mentions,
  // slowmode, attachments, the channel:<id> realtime room, read state — is keyed on channelId and
  // therefore works inside a thread with no duplication whatsoever. The alternative would have
  // meant reimplementing all of it against a second id column.
  THREAD
}

enum FriendStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

enum NotificationLevel {
  ALL
  MENTIONS
  NONE
}

/// How much proof a member needs before they can talk. Discord's own ladder, kept because it is
/// well understood and maps onto signals this codebase already has (account age, email verification,
/// membership age). Enforced in messages/service.ts, not just displayed.
enum VerificationLevel {
  NONE
  LOW // must have a verified email
  MEDIUM // ...and be registered on Lumina for longer than 5 minutes
  HIGH // ...and be a member of this server for longer than 10 minutes
}

/// Which messages get scanned for explicit media.
enum ExplicitContentFilter {
  DISABLED
  MEMBERS_WITHOUT_ROLES
  ALL_MEMBERS
}

// Lifecycle of an uploaded "For You" feed video. Deliberately review-gated: a video is only ever
// publicly readable in APPROVED, so nothing a user uploads reaches the global cross-server feed
// without a site admin acting on it first. PROCESSING -> (worker transcodes) -> PENDING_REVIEW ->
// APPROVED | REJECTED; REMOVED is a takedown of something previously APPROVED (kept distinct from
// REJECTED so the staff audit trail can tell "never published" from "published then pulled");
// FAILED is a transcode error, not a moderation outcome.
// Platform-wide authority ladder. Strictly ordered: each rank implies everything below it.
//
//   USER   — no platform authority.
//   STAFF  — the video review queue and the staff suite.
//   OWNER  — the owner suite: platform stats, user management, platform bans.
//   MASTER — a single account. The master suite: granting roles, platform configuration, and the
//            destructive actions nothing else may reach.
//
// MASTER can only ever be assigned from the MASTER_EMAIL env var, never through the API — not even
// by another master. That is deliberate: it means compromising an owner account (or the dashboard
// itself) cannot mint a new master, and the top of the ladder is only reachable by someone with
// shell access to the server. Deliberately NOT a permission bitfield like Role.permissions
// — that system is per-server and this one governs surfaces (the video queue, the owner dashboard,
// platform bans) that belong to no server at all.
enum PlatformRole {
  USER
  STAFF
  OWNER
  MASTER
}

// What a ban row matches on. One ban action typically writes several rows — the account plus its
// email, recent IPs and device fingerprints — so that signing up again from the same machine is
// caught. Kept as separate rows rather than nullable columns on one row so each identifier can be
// lifted independently (an IP is often shared and gets un-banned long before the account does).
enum BanScope {
  ACCOUNT
  EMAIL
  IP
  DEVICE
}

// Coarse age bands collected at signup. Five buckets rather than a free-form age because a bucket
// is far less identifying to store, and the only decision the platform actually makes from it is
// "is this account a minor".
enum AgeBracket {
  UNDER_18
  AGE_18_24
  AGE_25_34
  AGE_35_49
  AGE_50_PLUS
}

enum AppealStatus {
  NONE
  PENDING
  APPROVED
  DENIED
}

enum VideoStatus {
  PROCESSING
  PENDING_REVIEW
  APPROVED
  REJECTED
  REMOVED
  FAILED
}

model User {
  id                     String         @id @default(cuid())
  username               String         @unique
  displayName            String?
  email                  String         @unique
  passwordHash           String
  avatarUrl              String?
  statusText             String?
  // Short unicode emoji attached to statusText (Discord's custom-status-with-emoji pattern) —
  // plain unicode only, no custom-emoji FK (no CustomEmoji model exists yet).
  statusEmoji            String?        @db.VarChar(16)
  // Public profile fields (visible on any UserDTO, unlike the two privacy booleans below which
  // are only ever serialized onto the owning user's own DTO via serializeMe).
  bio                    String?        @db.VarChar(190)
  bannerUrl              String?
  pronouns               String?        @db.VarChar(40)
  presence               PresenceStatus @default(OFFLINE)
  // Bot accounts are just User rows with isBot: true, applicationId pointing at the Application
  // that owns them — deliberately NOT a parallel identity system. Every existing permission
  // check, membership row, message authorship, etc. treats a bot exactly like a human member;
  // it joins servers via the same invite flow and gets roles the same way. email/passwordHash
  // are still populated (synthesized, unusable for login) to satisfy the existing NOT NULL /
  // unique constraints without loosening them for real users — see modules/applications/service.ts.
  isBot                  Boolean        @default(false)
  applicationId          String?        @unique
  // Privacy & Safety settings (User Settings > Privacy & Safety). Enforced in
  // modules/friends/service.ts (sendFriendRequest) and modules/dm/routes.ts (new 1:1 DM
  // creation) — both default to true (Discord's own default), so this is purely opt-out.
  allowDmsFromNonFriends Boolean        @default(true)
  allowFriendRequests    Boolean        @default(true)
  // Platform-wide authority. The only global authorization concept in the schema — everything else
  // is per-server (Role.permissions bitfields via Membership), which cannot express "may moderate
  // the cross-server video feed" or "may ban from the platform" since those surfaces belong to no
  // server. Checked by requireStaff/requireOwner (plugins/authenticate.ts), NOT by checkPermission.
  // Bootstrapped from the OWNER_EMAILS / STAFF_EMAILS env vars at login, reconciled in both
  // directions, so the first owner never needs raw SQL and revoking is an env edit.
  platformRole           PlatformRole   @default(USER)
  /// A first-party Lumina account, shown with a badge users cannot fake.
  ///
  /// The badge exists BECAUSE the bio doesn't work as one: anyone can set their bio to "Official
  /// Lumina Staff" and upload the logo as their avatar, and on a platform where staff message
  /// people about moderation decisions that is a ready-made phishing kit. This flag is settable
  /// only by MASTER, so the badge is the one part of an official identity that can't be copied.
  isOfficial             Boolean        @default(false)
  // Age signals, collected at registration.
  //
  // `isMinor` is derived from birthDate and stored rather than computed per request because it
  // gates every friend request and DM creation — recomputing it from a date on each of those is
  // both slower and easier to get subtly wrong in one call site. It is refreshed on login, so an
  // account that turns 18 stops being restricted without any manual step.
  ageBracket             AgeBracket?
  birthDate              DateTime?
  isMinor                Boolean        @default(false)
  ageRecordedAt          DateTime?

  // ---- two-factor authentication ----
  //
  // The secret is stored ENCRYPTED, not hashed: TOTP verification needs the original value to
  // recompute the current code, so a one-way hash is impossible here. That makes it different from
  // passwordHash and worth stating — a database dump alone does not yield working second factors,
  // but a dump plus the application key does. See lib/totp.ts.
  totpSecret      String?
  totpEnabledAt   DateTime?
  // Single-use recovery codes, hashed with the same Argon2 as passwords. Stored hashed because they
  // ARE credentials — anyone holding one can complete a login.
  /// When the address on this account was confirmed by clicking a link sent to it. Null means
  /// unconfirmed — which is the state every account predating this feature is in, so it must never
  /// be treated as a reason to withhold access to something the account already had.
  emailVerifiedAt DateTime?
  totpBackupCodes TotpBackupCode[]
  passkeys        Passkey[]
  // ISO country code from Cloudflare's CF-IPCountry header at signup. Country granularity only:
  // enough to plot a dot on a world map, not enough to locate anyone.
  signupCountry   String?          @db.VarChar(2)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  refreshTokens          RefreshToken[]
  ownedServers           Server[]                 @relation("ServerOwner")
  memberships            Membership[]
  messages               Message[]
  reactions              Reaction[]
  dmParticipation        DMParticipant[]
  auditLogEntries        AuditLogEntry[]          @relation("Actor")
  ownedApplications      Application[]            @relation("ApplicationOwner")
  botApplication         Application?             @relation("BotUser", fields: [applicationId], references: [id], onDelete: Cascade)
  createdWebhooks        Webhook[]
  sentFriendRequests     FriendRequest[]          @relation("FriendRequester")
  receivedFriendRequests FriendRequest[]          @relation("FriendAddressee")
  oauthCodes             OAuthAuthorizationCode[] @relation("OAuthCodeUser")
  oauthTokens            OAuthAccessToken[]       @relation("OAuthTokenUser")
  pushSubscriptions      PushSubscription[]
  notificationOverrides  NotificationOverride[]
  videos                 Video[]                  @relation("VideoAuthor")
  reviewedVideos         Video[]                  @relation("VideoReviewer")
  staffAuditEntries      StaffAuditLog[]          @relation("StaffActor")
  videoLikes             VideoLike[]
  videoComments          VideoComment[]           @relation("VideoCommentAuthor")
  platformBans           PlatformBan[]            @relation("BannedUser")
  opsCommands            OpsCommand[]             @relation("OpsCommandRequester")
  adCampaigns            AdCampaign[]             @relation("AdAdvertiser")
  reviewedAdCampaigns    AdCampaign[]             @relation("AdReviewer")
  authoredAddons         Addon[]                  @relation("AddonAuthor")
  addonInstalls          ServerAddon[]            @relation("AddonInstaller")
  subscriptions          Subscription[]
  coinEntries            CoinLedgerEntry[]
  storeGrants            StoreGrant[]
  uploadedEmojis         CustomEmoji[]
  accountFlags           AccountFlag[]            @relation("FlaggedUser")
  transactions           Transaction[]
  issuedBans             PlatformBan[]            @relation("BanIssuer")
  videoReports           VideoReport[]            @relation("VideoReporter")
  resolvedVideoReports   VideoReport[]            @relation("VideoReportResolver")
  assignedVideoReports   VideoReport[]            @relation("VideoReportAssignee")
  createdTags            Tag[]                    @relation("TagCreator")
  suggestionState        FriendSuggestionState[]  @relation("SuggestionOwner")
  suggestedTo            FriendSuggestionState[]  @relation("SuggestionSubject")
  uploadedStickers       Sticker[]
  uploadedSounds         SoundboardSound[]
  pollVotes              PollVote[]
  interactions           Interaction[]
  createdTemplates       ServerTemplate[]         @relation("TemplateCreator")
  createdEvents          ServerEvent[]            @relation("EventCreator")
  eventRsvps             ServerEventRsvp[]
  creatorTier            CreatorTier?
  supporters             CreatorMembership[]      @relation("MembershipCreator")
  supporting             CreatorMembership[]      @relation("MembershipMember")
  threadMemberships ThreadMembership[]
  parentLinkAsChild  ParentLink?             @relation("ChildOfLink")
  parentLinksAsParent ParentLink[]           @relation("ParentOfLink")
  approvedForMinors  ParentApprovedContact[] @relation("ApprovedForMinor")
  gameLinks GameLink[]
  notifications      Notification[] @relation("InboxOwner")
  notificationActs   Notification[] @relation("InboxActor")
  memberXp           MemberXp[]
  creatorWallet   CreatorWallet?
  earningItems    EarningItem[]
  creatorProgram  CreatorProgram?
  payoutAccount   PayoutAccount?
  payouts         Payout[]
  giftsSent       GiftSend[] @relation("GiftsSent")
  giftsReceived   GiftSend[] @relation("GiftsReceived")
}

// A "dev portal" app a human user owns. Each Application has exactly one bot User (see
// User.applicationId above) — matches Discord's model, not a general OAuth client registry.
// "API generation & scopes" (roadmap Phase 4) deliberately reuses this: botTokenHash IS the API
// key, and scopes ARE whatever server roles/permissions the bot is assigned — no parallel scope
// system.
model Application {
  id               String                   @id @default(cuid())
  ownerId          String
  name             String
  description      String?
  iconUrl          String?
  botTokenHash     String?
  // OAuth2 (authorization-code grant, see modules/oauth2/) — the Application's own `id` doubles
  // as its OAuth client_id, matching Discord's model rather than minting a separate identifier.
  // redirectUris is an allowlist checked exactly (no wildcard/prefix matching) on both
  // /oauth2/authorize and /oauth2/token — a mismatch is a hard reject, standard OAuth2 practice
  // to prevent code/token redirection to an attacker-controlled URI.
  redirectUris     String[]                 @default([])
  clientSecretHash String?
  createdAt        DateTime                 @default(now())
  owner            User                     @relation("ApplicationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  botUser          User?                    @relation("BotUser")
  oauthCodes       OAuthAuthorizationCode[]
  oauthTokens      OAuthAccessToken[]
  addons           Addon[]                  @relation("AddonApplication")
  slashCommands    SlashCommand[]
  interactions     Interaction[]

  @@index([ownerId])
  activities Activity[]
}

// Short-lived (5 min), single-use authorization code — the intermediate step between a user
// approving an app's consent screen and the app exchanging it server-to-server for an access
// token. Never returned to the browser except as a URL param on the redirect itself; nothing
// about it is ever exposed to Lumina's own frontend beyond that one redirect.
model OAuthAuthorizationCode {
  id            String      @id @default(cuid())
  codeHash      String      @unique
  applicationId String
  userId        String
  redirectUri   String
  scope         String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user          User        @relation("OAuthCodeUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([userId])
}

// Deliberately NOT folded into the existing RefreshToken/access-token (JWT) machinery those
// serve human sessions — an OAuth token represents "this third-party App, acting with a user's
// consent, at exactly this scope" and is checked via a dedicated preHandler
// (modules/oauth2/authenticateOAuth.ts) used ONLY by GET /api/oauth2/identify, not the general
// requireAuth every other route uses. Scope is deliberately fixed to "identify" for v1 (read the
// consenting user's public profile) rather than a general-purpose scope system layered on top of
// the existing role/permission bitfield — a real expansion (e.g. an app posting messages on a
// user's behalf) is a bigger trust-boundary decision than this pass takes on.
model OAuthAccessToken {
  id            String      @id @default(cuid())
  tokenHash     String      @unique
  applicationId String
  userId        String
  scope         String
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user          User        @relation("OAuthTokenUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([userId])
}

model RefreshToken {
  id                String    @id @default(cuid())
  userId            String
  tokenHash         String
  userAgent         String?
  ipAddress         String?
  // Client-computed browser fingerprint (see frontend lib/deviceFingerprint.ts). Stored here
  // because a RefreshToken row already IS "one device/browser this account is signed in on", so
  // banning an account can collect its known devices without a parallel table. Nullable: older
  // sessions predate it and non-browser clients may not send one.
  deviceFingerprint String?
  expiresAt         DateTime
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Server {
  id              String   @id @default(cuid())
  name            String
  iconUrl         String?
  bannerUrl       String?
  // Packed 24-bit RGB int, same representation Role.color already uses — an owner/MANAGE_SERVER
  // pick that recolors the accent (--ion/--aurora/--accent-hover in index.css) for every member
  // viewing THIS server, scoped to the channel view only (see components/layout/AppShell.tsx).
  // null = no override, falls back to each member's own personal accent theme.
  accentColor     Int?
  ownerId         String
  systemChannelId String?
  createdAt       DateTime @default(now())

  // ---- Moderation ----
  verificationLevel     VerificationLevel     @default(NONE)
  explicitContentFilter ExplicitContentFilter @default(DISABLED)

  // ---- Defaults for new members ----
  /// Server-wide default. A member's own NotificationOverride still wins; this only decides what
  /// happens for someone who has never touched the setting.
  defaultNotificationLevel NotificationLevel @default(ALL)

  // ---- Inactive (AFK) voice ----
  /// Members idle in voice this long are moved here. Null disables it entirely.
  afkChannelId  String?
  afkTimeoutSec Int     @default(300)

  // ---- System messages ----
  /// Each toggles one kind of automatic post in systemChannelId. Separate booleans rather than a
  /// bitfield: there are three, they are read individually, and a bitfield would be unreadable in
  /// psql for no saving.
  sysJoinMessages  Boolean @default(true)
  sysLeaveMessages Boolean @default(false)
  sysBoostMessages Boolean @default(true)

  // ---- Community ----
  /// Shown on the join gate when set, so people see the rules before they can post.
  rulesChannelId        String?
  description           String?
  /// Human-friendly invite code (lumina.badgerstudios.net/invite/<vanity>). Unique across the
  /// instance because it shares a namespace with generated invite codes — see the check in
  /// invites/serverRoutes.ts, which must reject a vanity that collides with an existing Invite.
  vanityCode            String?                @unique
  /// Opt-IN to the public Discover surface. Default false, and that default is the security
  /// property: every server on this instance predates discovery, and none of them chose to be
  /// listed. An unscoped directory would leak the name and existence of every private community —
  /// the same concern lookup/routes.ts documents for server search.
  discoverable          Boolean                @default(false)
  /// "host" or "host:port" of the Minecraft server this community runs, if any. Powers the live
  /// status chip. Stored as text and resolved+validated at ping time (modules/game/minecraft.ts)
  /// because the DNS answer, not the string, is what decides whether it is safe to dial.
  minecraftHost         String?
  owner                 User                   @relation("ServerOwner", fields: [ownerId], references: [id])
  memberships           Membership[]
  channels              Channel[]
  roles                 Role[]
  invites               Invite[]
  bans                  Ban[]
  auditLogEntries       AuditLogEntry[]
  notificationOverrides NotificationOverride[]
  addons                ServerAddon[]
  autoModRules          AutoModRule[]
  customEmojis          CustomEmoji[]
  stickers              Sticker[]
  soundboardSounds      SoundboardSound[]
  templatesFrom         ServerTemplate[]       @relation("TemplateSource")
  memberXp     MemberXp[]
  levelRewards LevelReward[]
  events       ServerEvent[]
}

model Membership {
  id         String           @id @default(cuid())
  userId     String
  serverId   String
  nickname   String?
  mutedUntil DateTime?
  joinedAt   DateTime         @default(now())
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  server     Server           @relation(fields: [serverId], references: [id], onDelete: Cascade)
  roles      RoleAssignment[]

  @@unique([userId, serverId])
  @@index([serverId])
}

model Role {
  id          String           @id @default(cuid())
  serverId    String
  name        String
  color       Int?
  permissions BigInt
  position    Int
  isDefault   Boolean          @default(false)
  mentionable Boolean          @default(true)
  createdAt   DateTime         @default(now())
  server      Server           @relation(fields: [serverId], references: [id], onDelete: Cascade)
  assignments RoleAssignment[]

  @@index([serverId])
  levelRewards LevelReward[]
}

model RoleAssignment {
  id           String     @id @default(cuid())
  membershipId String
  roleId       String
  assignedAt   DateTime   @default(now())
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([membershipId, roleId])
  /// The unique above is keyed on membershipId, so it cannot serve a lookup BY role — and "who
  /// holds this role" runs inside permission computation, which runs on every message send.
  @@index([roleId])
}

model Channel {
  id              String      @id @default(cuid())
  serverId        String
  name            String
  type            ChannelType @default(TEXT)
  topic           String?
  parentId        String?
  position        Int
  // Seconds a member must wait between messages in this channel (0 = off). Enforced in
  // modules/messages/service.ts's createChannelMessage; MANAGE_MESSAGES bypasses it, same as
  // Discord's own moderator exemption.
  slowmodeSeconds Int         @default(0)
  nsfw            Boolean     @default(false)
  createdAt       DateTime    @default(now())
  server          Server      @relation(fields: [serverId], references: [id], onDelete: Cascade)
  parent          Channel?    @relation("ChannelToCategory", fields: [parentId], references: [id])
  children        Channel[]   @relation("ChannelToCategory")
  messages        Message[]
  webhooks        Webhook[]
  overwrites      ChannelPermissionOverwrite[]
  events          ServerEvent[]

  // ---- thread fields (null/default on every non-THREAD channel)
  //
  // The message this thread was started from, if any. Unique because a message can spawn at most
  // one thread — the second "create thread" on the same message must open the existing one, and a
  // unique index is what makes that a database guarantee rather than a race between two clicks.
  // Cascade: if the origin message is deleted the thread goes with it, matching the fact that the
  // thread is rendered as part of that message.
  threadOriginMessageId BigInt?  @unique
  threadOrigin          Message? @relation("MessageThread", fields: [threadOriginMessageId], references: [id], onDelete: Cascade)
  // Archived threads stay readable and keep their messages; they are hidden from the active list
  // and re-open on the next post. Discord's model, and it avoids a destructive sweep.
  archived              Boolean  @default(false)
  archivedAt            DateTime?
  autoArchiveMinutes    Int      @default(4320)
  /// Last message time, denormalised. The auto-archive sweep runs over every active thread on a
  /// schedule; deriving this with a correlated MAX(Message.createdAt) per thread would make that
  /// sweep's cost grow with total message volume rather than with thread count.
  lastActivityAt        DateTime?
  threadMembers         ThreadMembership[]

  @@index([serverId])
  /// Backs both the active-thread list for one parent channel and the auto-archive sweep.
  @@index([parentId, archived])
}

/**
 * Who has explicitly joined a thread, for notification purposes.
 *
 * Not inferred from message history: "has posted here" and "wants to hear about this" are
 * different questions. Someone who read a thread and never replied still wants replies, and
 * someone who posted once and left does not — neither is answerable from Message alone.
 */
model ThreadMembership {
  channelId String
  userId    String
  joinedAt  DateTime @default(now())
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([userId])
}

/// Numeric alias for a cuid-keyed entity, minted on first use. Discord-protocol clients do
/// BigInt arithmetic on ids (sharding math, timestamp extraction), so the compat layer must hand
/// them numeric snowflake-shaped strings — cuids would crash those libraries. Messages already
/// have BigInt ids and use them directly; everything else resolves through this table, which
/// makes the mapping stable across restarts (an in-memory counter would re-mint different ids
/// and break every bot's cache on reboot).
model CompatId {
  id       BigInt @id @default(autoincrement())
  kind     String
  luminaId String

  @@unique([kind, luminaId])
}

enum EventRsvpStatus {
  GOING
  INTERESTED
}

/**
 * A scheduled server event — the strongest planned-comeback trigger a community has. Either a
 * `channelId` (it happens in a voice/stage channel here) or a free-text `location` (somewhere
 * else: a game lobby, a URL, a street address); both null is legal and means "announced, place
 * TBD".
 */
model ServerEvent {
  id          String    @id @default(cuid())
  serverId    String
  creatorId   String?
  name        String
  description String?
  channelId   String?
  location    String?
  startsAt    DateTime
  endsAt      DateTime?
  canceledAt  DateTime?
  /// Set once the pre-start reminder sweep has notified RSVPs — the sweep's idempotency marker,
  /// so a worker restart cannot re-remind the same event.
  remindedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  server  Server            @relation(fields: [serverId], references: [id], onDelete: Cascade)
  creator User?             @relation("EventCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  channel Channel?          @relation(fields: [channelId], references: [id], onDelete: SetNull)
  rsvps   ServerEventRsvp[]

  @@index([serverId, startsAt])
  /// The reminder sweep: upcoming, not yet reminded.
  @@index([startsAt])
}

enum CreatorMembershipStatus {
  INCOMPLETE
  ACTIVE
  PAST_DUE
  CANCELED
}

/// A creator's monthly supporter tier — one per creator in v1. The price is captured onto each
/// membership at subscribe time, so a later price change never silently rebills existing
/// supporters at a number they didn't agree to.
model CreatorTier {
  creatorId   String   @id
  name        String   @default("Supporter")
  description String?
  /// Monthly price in USD minor units. Bounded at the route ($1–$50).
  priceMinor  Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator User @relation(fields: [creatorId], references: [id], onDelete: Cascade)
}

/// One supporter's recurring membership to one creator. Money never moves from this row — each
/// paid invoice flows through the revenue-event funnel like every other product; this row is the
/// relationship (who supports whom, at what state).
model CreatorMembership {
  id                   String                  @id @default(cuid())
  creatorId            String
  memberId             String
  status               CreatorMembershipStatus @default(INCOMPLETE)
  priceMinor           Int
  stripeSubscriptionId String?                 @unique
  currentPeriodEnd     DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  creator User @relation("MembershipCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  member  User @relation("MembershipMember", fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([creatorId, memberId])
  @@index([memberId])
}

model ServerEventRsvp {
  eventId   String
  userId    String
  status    EventRsvpStatus @default(GOING)
  createdAt DateTime        @default(now())

  event ServerEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId])
}

enum OverwriteTargetType {
  ROLE
  USER
}

/**
 * A per-channel adjustment to the server-wide permissions a role or member already has.
 *
 * Two bitfields rather than one, because a channel has to be able to express both directions
 * independently: "this role may post here even though it cannot post server-wide" (allow) and
 * "this role may not post here even though it can everywhere else" (deny). A single field could
 * only ever say one of those, and a tri-state per bit is exactly what two fields encode — a bit
 * set in neither means "inherit", which is the common case and correctly stays sensitive to later
 * changes in the underlying role.
 *
 * `targetId` is intentionally not a foreign key: it points at a Role or a User depending on
 * `targetType`, and Prisma cannot express a polymorphic relation. Cleanup of stale rows is
 * therefore explicit — see deleteChannelOverwritesForRole, called when a role is deleted.
 */
model ChannelPermissionOverwrite {
  id         String              @id @default(cuid())
  channelId  String
  targetType OverwriteTargetType
  targetId   String
  allow      BigInt              @default(0)
  deny       BigInt              @default(0)
  createdAt  DateTime            @default(now())
  channel    Channel             @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, targetType, targetId])
  @@index([channelId])
}

model Message {
  id                BigInt                   @id @default(autoincrement())
  channelId         String?
  dmConversationId  String?
  authorId          String?
  content           String
  editedAt          DateTime?
  deletedAt         DateTime?
  pinned            Boolean                  @default(false)
  replyToId         BigInt?
  createdAt         DateTime                 @default(now())
  channel           Channel?                 @relation(fields: [channelId], references: [id], onDelete: Cascade)
  conversation      DMConversation?          @relation(fields: [dmConversationId], references: [id], onDelete: Cascade)
  author            User?                    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  attachments       Attachment[]
  reactions         Reaction[]
  mentions          MessageMention[]
  // Discord-style incoming webhook post: authorId stays null (same "no real user" shape a
  // deleted user's message already has — serializeMessage renders these using
  // overrideUsername/overrideAvatarUrl instead of a User lookup). webhookId surviving the
  // Webhook's own deletion (SetNull) matches every other "referenced thing got deleted, keep
  // the message" precedent already in this schema (Message.author, AuditLogEntry.actor).
  webhookId         String?
  overrideUsername  String?
  overrideAvatarUrl String?
  webhook           Webhook?                 @relation(fields: [webhookId], references: [id], onDelete: SetNull)
  // A sticker or a poll is the message's *body*, not an attachment to it — hence a nullable FK on
  // Message rather than a row in Attachment. Both are SetNull for the reason webhookId already
  // documents above: deleting the referenced thing must not delete the conversation history that
  // mentioned it. A message whose sticker was deleted renders as an empty sticker frame, exactly
  // like one whose author was deleted renders as "[deleted user]".
  stickerId         String?
  sticker           Sticker?                 @relation(fields: [stickerId], references: [id], onDelete: SetNull)
  pollId            String?
  poll              Poll?                    @relation(fields: [pollId], references: [id], onDelete: SetNull)
  // Interactive components (buttons/selects) a bot attached to this message, as the serialized
  // action-row tree the bot sent. JSON for the same reason SlashCommand.optionsJson is: it is read
  // whole to draw a UI and never queried into.
  componentsJson    Json?
  embeds            MessageEmbed[]
  thread            Channel?                 @relation("MessageThread")
  // Managed by the hand-written message_search_and_checks migration (raw SQL
  // trigger keeps this in sync with `content`); Unsupported so Prisma is
  // aware of it (no drift-detection prompts) without trying to manage it.
  searchVector      Unsupported("tsvector")?

  @@index([channelId, id])
  @@index([dmConversationId, id])
  /// Every message a user wrote. Two paths need this and both are user-visible:
  /// the account data export, and account DELETION — authorId is SetNull-on-delete, so removing an
  /// account with a long history was a full scan of Message per delete.
  @@index([authorId])
}

// Discord-style incoming webhook: a channel-scoped, token-authenticated URL (no user session
// needed) that posts a message with a caller-chosen display identity (Message.overrideUsername/
// overrideAvatarUrl), for external services to push messages in without needing a bot account.
model Webhook {
  id        String    @id @default(cuid())
  channelId String
  name      String
  avatarUrl String?
  tokenHash String
  creatorId String
  createdAt DateTime  @default(now())
  channel   Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  creator   User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([channelId])
}

model MessageMention {
  id        String  @id @default(cuid())
  messageId BigInt
  userId    String?
  roleId    String?
  everyone  Boolean @default(false)
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  /// Joined on every message list render; unindexed it scanned the whole table per page.
  @@index([messageId])
}

model Attachment {
  id        String   @id @default(cuid())
  messageId BigInt
  fileName  String
  mimeType  String
  sizeBytes Int
  url       String
  width     Int?
  height    Int?
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  /// Joined on every message list render; unindexed it scanned the whole table per page.
  @@index([messageId])
}

model Reaction {
  id            String       @id @default(cuid())
  messageId     BigInt
  userId        String
  /// For a unicode reaction this is the character itself. For a custom emoji it is the emoji's
  /// NAME, kept denormalised so the existing @@unique still prevents double-reacting and so a
  /// deleted emoji leaves a readable trace rather than a dangling id.
  emoji         String
  /// Set only for custom emoji. A foreign key rather than string matching on `emoji`: renaming an
  /// emoji would otherwise silently split one reaction into two.
  customEmojiId String?
  createdAt     DateTime     @default(now())
  message       Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  customEmoji   CustomEmoji? @relation(fields: [customEmojiId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

model DMConversation {
  id           String          @id @default(cuid())
  isGroup      Boolean         @default(false)
  name         String?
  createdAt    DateTime        @default(now())
  participants DMParticipant[]
  messages     Message[]
}

model DMParticipant {
  id                String         @id @default(cuid())
  conversationId    String
  userId            String
  joinedAt          DateTime       @default(now())
  lastReadMessageId BigInt?
  conversation      DMConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  // The composite unique above leads with conversationId, so "which conversations is this user
  // in" — the entry point for the whole DM-overlap half of friend suggestions — cannot use it.
  @@index([userId])
}

model ChannelReadState {
  id                String    @id @default(cuid())
  userId            String
  channelId         String
  lastReadMessageId BigInt?
  lastReadAt        DateTime?

  @@unique([userId, channelId])
}

model FriendRequest {
  id          String       @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  respondedAt DateTime?
  // Was plain String columns with no @relation at all before this — no FK enforcement, no
  // back-relation on User. Never had a route or a row in it, so nothing to migrate.
  requester   User         @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User         @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

model Invite {
  code      String    @id
  serverId  String
  creatorId String
  maxUses   Int?
  uses      Int       @default(0)
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  server    Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
}

model Ban {
  id         String   @id @default(cuid())
  serverId   String
  userId     String
  reason     String?
  bannedById String
  createdAt  DateTime @default(now())
  server     Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, userId])
}

model AuditLogEntry {
  id         String   @id @default(cuid())
  serverId   String
  // Nullable + SetNull (not the implicit Restrict a bare relation defaults to) — same reasoning
  // as Message.author: a human never actually gets their User row deleted (leaving/being
  // removed only deletes their Membership), so this FK never mattered until bots existed. A
  // deleted bot's Application cascades to delete its User row (see User.applicationId), and
  // that bot may well be the actor on real audit log entries (e.g. joining via invite) — losing
  // the whole audit trail entry, or hard-blocking the bot's deletion entirely, would both be
  // worse than just recording "actor no longer exists" like a deleted human message already does.
  actorId    String?
  actionType String
  targetId   String?
  targetType String?
  metadata   Json?
  createdAt  DateTime @default(now())
  server     Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  actor      User?    @relation("Actor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([serverId, createdAt])
}

// Real W3C Web Push subscriptions (VAPID) — one row per browser/device the user has opted in
// on, since a subscription is tied to a specific ServiceWorkerRegistration, not the account.
// `platform` is currently always "web" (mobile Android push needs Firebase Cloud Messaging,
// deliberately not built yet — see lumina_roadmap.md's push notification entry for why) but the
// column exists now so adding an "android"/FCM row shape later is additive, not a rearchitect.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  platform  String   @default("web")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Per-server or per-channel push-notification level, layered as channel override -> server
// override -> global default (ALL). channelId uses "" as the "server-wide" sentinel rather than
// SQL NULL — Postgres treats NULL as distinct-from-itself in a unique index, so a nullable
// channelId column would let multiple "server-level" rows exist per (userId, serverId) with no
// constraint violation. The empty-string sentinel keeps @@unique meaningful; app code (see
// modules/notifications/service.ts) never treats "" as a real channel id, and there's no FK to
// Channel for exactly this reason (a real FK can't target a sentinel).
model NotificationOverride {
  id        String            @id @default(cuid())
  userId    String
  serverId  String
  channelId String            @default("")
  level     NotificationLevel
  createdAt DateTime          @default(now())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  server    Server            @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([userId, serverId, channelId])
  @@index([userId])
}

// A short-form video in the global cross-server "For You" feed. Belongs to no server and no
// channel — the first content model in the schema that isn't scoped to one or the other, which is
// why access control for it is User.isSiteAdmin rather than a per-server permission bit.
//
// BigInt autoincrement PK (matching Message, and unlike the cuid() used everywhere else)
// specifically so lib/pagination.ts's `id < cursor` cursor pagination works unchanged — the feed
// and the comment list both need strictly-increasing ids.
//
// The three *Key columns are on-disk filenames under UPLOADS_DIR/videos/{source,playback,thumbs},
// not URLs: what's stored is an opaque id, and the routes that serve them re-check authorization
// per request. `sourceKey` is the raw upload (deleted once transcoding succeeds, to reclaim disk —
// video is by far the largest thing this instance stores); `playbackKey`/`thumbnailKey` stay null
// until the worker finishes, which is what makes PROCESSING distinguishable from PENDING_REVIEW.
//
// likeCount/viewCount/commentCount are denormalized for feed ranking — the join tables are the
// source of truth for likes/comments, but ranking a feed can't afford a COUNT per candidate row.
// viewCount has no join table at all by design: one row per view is unbounded growth, so views are
// deduped per user in Redis and only the counter is persisted.
model Video {
  id       BigInt      @id @default(autoincrement())
  authorId String?
  caption  String?     @db.VarChar(300)
  status   VideoStatus @default(PROCESSING)

  sourceKey    String
  playbackKey  String?
  thumbnailKey String?

  mimeType   String
  sizeBytes  Int
  // Hash of the raw upload — lets a re-upload of identical bytes be detected mechanically
  // (the only "automatic" moderation in v1; everything else is human review).
  sha256     String
  durationMs Int?
  width      Int?
  height     Int?

  // Set when status is FAILED, so the uploader sees why instead of a video stuck forever.
  failureReason String?

  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?   @db.VarChar(300)

  likeCount    Int @default(0)
  viewCount    Int @default(0)
  commentCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // SetNull, matching the existing Message.author precedent — a deleted account's videos survive
  // as "[deleted user]" rather than cascading away content other people may have engaged with.
  author     User? @relation("VideoAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  reviewedBy User? @relation("VideoReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  // (status, id) drives both the public feed (status=APPROVED, id < cursor) and every staff queue
  // tab (status=PENDING_REVIEW, ...) — the two hottest queries against this table.
  // Upload provenance, recorded so an unlawful upload can actually be attributed.
  //
  // Stored in the clear rather than hashed, unlike the ban and flag tables: a hash proves a match
  // you already suspect, but cannot answer "who uploaded this" for a lawful request, which is the
  // entire reason for keeping it. Exposed ONLY to the master account — staff moderate content and
  // have no need for an uploader's address — and purged after PROVENANCE_RETENTION_DAYS so it does
  // not accumulate indefinitely.
  uploadIp           String?
  uploadDevice       String?
  uploadUserAgent    String?
  provenancePurgedAt DateTime?

  // --- Remix (stitch / duet) -----------------------------------------------------------------
  //
  // Consent is per-video and defaults to ON, matching every platform that has this feature — but
  // it is checked server-side on every derivative creation, not just hidden in the UI. Two flags
  // rather than one because they are genuinely different asks: a duet puts your face beside
  // someone else's, a stitch lets them quote a few seconds of you in front of their own point.
  allowStitch Boolean @default(true)
  allowDuet   Boolean @default(true)

  // What this video was made FROM, if anything. SetNull rather than Cascade: a derivative is
  // substantially the deriving creator's own work and deleting the original must not silently
  // destroy it. When staff *remove* an original, its derivatives are pushed back into the review
  // queue instead (see modules/staff), because they embed footage a human has just judged.
  sourceVideoId   BigInt?
  derivativeType  VideoDerivativeType?
  // The slice of the source used by a stitch, in ms. Null for a duet, which uses the whole thing.
  sourceStartMs   Int?
  sourceEndMs     Int?
  // Denormalised, like likeCount: "how many people remixed this" is shown on a card and cannot
  // afford a COUNT per feed candidate.
  derivativeCount Int                  @default(0)

  sourceVideo Video?  @relation("VideoDerivatives", fields: [sourceVideoId], references: [id], onDelete: SetNull)
  derivatives Video[] @relation("VideoDerivatives")

  adCampaigns AdCampaign[] @relation("AdVideo")

  viewDays VideoViewDay[]

  likes    VideoLike[]
  comments VideoComment[]
  reports  VideoReport[]
  tags     VideoTag[]

  @@index([status, id])
  @@index([authorId, id])
  @@index([sha256])
  // Drives both "show me everything made from this video" and the moderation sweep that re-queues
  // derivatives when an original is taken down.
  @@index([sourceVideoId, id])
}

/// How a video was derived from another. STITCH prepends a short slice of the original to the
/// creator's own clip; DUET plays both side by side.
enum VideoDerivativeType {
  STITCH
  DUET
}

// Platform-level moderation trail, separate from AuditLogEntry.
//
// AuditLogEntry is server-scoped (serverId is required and every existing query filters on it), and
// the actions recorded here belong to no server — approving a video in the global feed isn't an
// event in anyone's server log. Making AuditLogEntry.serverId nullable to share one table would
// have meant auditing every existing server-scoped query for rows that now don't match, which is a
// far larger and riskier change than a second, purpose-built table. The parity roadmap's
// cross-server admin dashboard reuses this rather than adding a third audit concept.
//
// Deliberately append-only: nothing in the app updates or deletes rows here. A takedown record that
// a moderator can quietly edit isn't a record.
model StaffAuditLog {
  id         String   @id @default(cuid())
  // SetNull rather than Cascade — a staff member's account being deleted must not erase the
  // history of actions they took.
  actorId    String?
  actionType String
  targetType String
  targetId   String
  reason     String?  @db.VarChar(300)
  createdAt  DateTime @default(now())
  actor      User?    @relation("StaffActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([targetType, targetId])
}

// A like on a feed video. Composite PK on (videoId, userId) rather than a surrogate id: it makes
// liking naturally idempotent (a double-tap or a retried request collides instead of double-
// counting) and is the exact lookup the feed needs to answer "has this viewer liked this".
// Video.likeCount is the denormalized counter kept in step with these rows inside a transaction —
// ranking a feed can't afford a COUNT per candidate.
//
// There is deliberately no equivalent model for views: one row per view is unbounded growth, so
// views are deduped per user in Redis and only Video.viewCount is persisted.
model VideoLike {
  videoId   BigInt
  userId    String
  createdAt DateTime @default(now())
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([videoId, userId])
  @@index([userId])
}

enum ReportReason {
  SPAM
  HARASSMENT
  VIOLENCE
  SEXUAL_CONTENT
  HATE_SPEECH
  SELF_HARM
  ILLEGAL
  OTHER
}

// Ticket lifecycle for a report. OPEN -> IN_PROGRESS (a named person has picked it up) ->
// INVESTIGATING (actively being looked into) -> COMPLETED. DISMISSED closes it without action.
// RESOLVED is retained because existing rows carry it; new tickets use COMPLETED.
enum ReportStatus {
  OPEN
  IN_PROGRESS
  INVESTIGATING
  COMPLETED
  RESOLVED
  DISMISSED
}

// A comment on a feed video. BigInt autoincrement PK for the same reason Message and Video use one:
// lib/pagination.ts's `id < cursor` pagination needs strictly increasing ids.
model VideoComment {
  id        BigInt   @id @default(autoincrement())
  videoId   BigInt
  authorId  String?
  content   String   @db.VarChar(500)
  createdAt DateTime @default(now())
  // Cascade from the video (a deleted video's comments are meaningless) but SetNull from the
  // author, matching the Message.author precedent — a deleted account leaves "[deleted user]"
  // rather than tearing holes in other people's conversations.
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  author    User?    @relation("VideoCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([videoId, id])
}

// A user report against a video.
//
// @@unique([videoId, reporterId]) is load-bearing, not hygiene: the auto-unpublish threshold counts
// DISTINCT reporters, so without it one person could bury any video by reporting it repeatedly.
// That is the whole difference between a report system and a heckler's veto.
model VideoReport {
  id             String       @id @default(cuid())
  videoId        BigInt
  reporterId     String?
  reason         ReportReason
  details        String?      @db.VarChar(500)
  status         ReportStatus @default(OPEN)
  // Who picked the ticket up. Recorded at claim time rather than only at resolution so an
  // in-progress ticket has an owner — otherwise two people work the same report unaware.
  assignedToId   String?
  assignedAt     DateTime?
  // Written when the ticket is completed and sent back to whoever filed it. A report that
  // disappears into a queue with no reply teaches people not to bother reporting.
  resolutionNote String?      @db.VarChar(1000)
  resolvedById   String?
  resolvedAt     DateTime?
  // Rating left by the REPORTER after the ticket closes, 1-5. One star = one point to the staff
  // member who resolved it.
  //
  // Deliberately optional and one-shot: most people won't rate, and a system that nagged for a
  // score would make reporting feel like work. Absent ratings are excluded from averages rather
  // than counted as zero — treating silence as a bad score would punish staff for the common case.
  rating         Int?
  ratedAt        DateTime?
  createdAt      DateTime     @default(now())
  video          Video        @relation(fields: [videoId], references: [id], onDelete: Cascade)
  reporter       User?        @relation("VideoReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  resolvedBy     User?        @relation("VideoReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  assignedTo     User?        @relation("VideoReportAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@unique([videoId, reporterId])
  @@index([status, createdAt])
  @@index([videoId])
}

// One banned identifier. A single "ban this user" action fans out into several of these (ACCOUNT +
// EMAIL + each recent IP + each known device fingerprint), grouped by `groupId` so the dashboard can
// present them as one action and lift them together.
//
// Honest limits, worth stating where the model lives: a browser cannot read real hardware IDs — no
// MAC address, no disk serial, no TPM. `DEVICE` here is a fingerprint derived from canvas/WebGL/font/
// UA entropy, which reliably catches "same person, same browser, new account" and does NOT catch a
// fresh browser profile, a different machine, or a VPN paired with a new signup. It can also collide
// across genuinely different people on locked-down or corporate-imaged machines that expose identical
// entropy. That collision risk is exactly why the appeal fields below are part of the model rather
// than an optional extra.
model PlatformBan {
  id                String   @id @default(cuid())
  // Groups the rows written by one ban action so they can be listed and lifted as a unit.
  groupId           String
  scope             BanScope
  // Exactly one of these is set, according to `scope`.
  userId            String?
  email             String?
  ipAddress         String?
  deviceFingerprint String?

  reason     String    @db.VarChar(500)
  bannedById String?
  // null means permanent. A finite expiry is preferred for IP and DEVICE scopes, where the chance
  // of hitting an innocent third party grows the longer the row lives.
  expiresAt  DateTime?
  liftedAt   DateTime?
  liftedById String?

  appealStatus     AppealStatus @default(NONE)
  appealText       String?      @db.VarChar(1000)
  appealedAt       DateTime?
  appealResponse   String?      @db.VarChar(500)
  appealResolvedAt DateTime?

  createdAt DateTime @default(now())

  // SetNull on the issuer, Cascade on the banned account: deleting a moderator must not erase the
  // ban they issued, but a deleted account's own ban rows are meaningless.
  user     User? @relation("BannedUser", fields: [userId], references: [id], onDelete: Cascade)
  bannedBy User? @relation("BanIssuer", fields: [bannedById], references: [id], onDelete: SetNull)

  // Each lookup path the login/register/request checks use gets its own index — these are read on
  // every authentication attempt, so they must not table-scan.
  @@index([groupId])
  @@index([userId])
  @@index([email])
  @@index([ipAddress])
  @@index([deviceFingerprint])
  @@index([appealStatus])
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  UNPAID
}

enum TransactionKind {
  CHARGE
  REFUND
}

// A Stripe subscription mirrored locally.
//
// Stripe is the source of truth for billing state; this table exists so the app can answer "is this
// user subscribed" without a network call on every request, and so the owner dashboard can report
// without paging the Stripe API. It is only ever written from verified webhook events, never from
// client input — a client claiming it paid is not evidence that it did.
model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  stripeCustomerId     String
  stripeSubscriptionId String             @unique
  status               SubscriptionStatus
  planKey              String
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

// Money that actually moved. Append-only: a refund is a new REFUND row, never an edit or delete of
// the original charge, so the ledger always reconciles against Stripe's own records.
//
// `stripeEventId` is unique and load-bearing: Stripe retries webhook delivery until it gets a 2xx,
// so the same event WILL arrive more than once. Without this constraint every retry would double-
// count revenue.
model Transaction {
  id                    String          @id @default(cuid())
  userId                String?
  stripeEventId         String          @unique
  stripePaymentIntentId String?
  kind                  TransactionKind
  // Minor units (cents), matching Stripe's own representation. Never a float — binary floating
  // point cannot represent money exactly and rounding drift in a ledger is unacceptable.
  amountCents           Int
  currency              String          @default("usd")
  description           String?
  createdAt             DateTime        @default(now())
  user                  User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
}

// One recorded download of an app release (APK / desktop build).
//
// A row per download rather than a counter so the dashboard can show trends over time and break it
// down by platform and version. IPs are stored hashed — this is analytics, and analytics does not
// need to be able to identify anyone.
model AppDownload {
  id        String   @id @default(cuid())
  platform  String
  version   String?
  fileName  String
  country   String?  @db.VarChar(2)
  ipHash    String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([platform, createdAt])
}

// Why an account or device was blocked, errored, or restricted.
//
// A stable, searchable catalogue rather than free text: support answers "why can't I get in" many
// times a day, and a code that both the user and the owner console can quote turns that from a
// guessing game into a lookup. Codes are defined in packages/shared/src/blockReasons.ts and stored
// here as strings so adding one never needs a migration.
model AccountFlag {
  id           String    @id @default(cuid())
  userId       String?
  // Recorded even when there is no account yet (a blocked signup), which is exactly the case an
  // account-scoped row could not represent.
  email        String?
  ipHash       String?
  deviceHash   String?
  reasonCode   String
  detail       String?   @db.VarChar(500)
  severity     String    @default("INFO")
  // Whether this flag is currently blocking access, as opposed to being a historical record.
  active       Boolean   @default(true)
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime  @default(now())
  user         User?     @relation("FlaggedUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([reasonCode, createdAt])
  @@index([userId])
  @@index([active, createdAt])
  @@index([deviceHash])
}

// A user-created tag on the video feed.
//
// `name` is the normalised form (lowercase, trimmed) and is the unique key, so "Gaming", "gaming"
// and " gaming " are one tag rather than three — without that, a tag index fragments immediately and
// searching it stops working. `displayName` keeps the casing the creator actually typed.
//
// `useCount` is denormalised because tag suggestions rank by popularity on every keystroke, and a
// COUNT over the join table per candidate is exactly the query that makes a typeahead feel slow.
model Tag {
  id          String     @id @default(cuid())
  name        String     @unique
  displayName String
  createdById String?
  useCount    Int        @default(0)
  createdAt   DateTime   @default(now())
  createdBy   User?      @relation("TagCreator", fields: [createdById], references: [id], onDelete: SetNull)
  videos      VideoTag[]

  @@index([useCount])
  @@index([name])
}

model VideoTag {
  videoId BigInt
  tagId   String
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([videoId, tagId])
  @@index([tagId])
}

/// One person's private state about ONE friend suggestion.
///
/// Deliberately NOT a fourth value on FriendStatus, which was the tempting zero-new-table option.
/// FriendRequest is simultaneously the friend graph, the request queue AND the block list — every
/// `status ===` check in friends/service.ts would need re-auditing, and blockUser's deleteMany
/// would silently wipe dismissals. A dismissal also isn't a relationship: it is one person's UI
/// state about their own panel, inherently one-directional in a table whose semantics are pairwise.
///
/// It cannot live in Redis either: compose.yml runs redis with `--save ""`, no volume and
/// noeviction, so every dismissal would be lost on the next deploy — "I already told you three
/// times I don't know this person" is a bad thing to forget.
///
/// Carries the impression counter too, so "stop showing me the same five people" needs no second
/// store. No `id` and no `updatedAt`: nothing reads them.
model FriendSuggestionState {
  userId      String
  subjectId   String
  dismissedAt DateTime?
  shownCount  Int       @default(0)
  lastShownAt DateTime?
  user        User      @relation("SuggestionOwner", fields: [userId], references: [id], onDelete: Cascade)
  subject     User      @relation("SuggestionSubject", fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([userId, subjectId])
  @@index([userId, dismissedAt])
}

// ---------------------------------------------------------------------------------------------
// Lumina Control — infrastructure monitoring and a narrow set of service actions.
//
// The trust direction here is the whole design, so it is written down where the models are.
//
// The obvious implementation is to give the API access to the Docker socket and let the owner
// console call it. That is also how you turn "someone found an auth bug in the chat app" into
// "someone owns the host": the Docker socket is root-equivalent, and the API is the one process on
// this box that the public internet can reach.
//
// So the API never talks to Docker at all. A separate agent runs on the host, OUTSIDE the
// containers, and *polls in*: every cycle it POSTs a snapshot and receives whatever commands are
// queued. Nothing inbound ever reaches Docker; the agent decides what it is willing to run from an
// allowlist compiled into it, and an attacker who fully controls the API can still only ask for
// things on that list.
//
// It also fails honestly: if the agent stops, the dashboard says "last seen 6 minutes ago" instead
// of quietly showing a stale green.
// ---------------------------------------------------------------------------------------------

model OpsSnapshot {
  id        BigInt   @id @default(autoincrement())
  /// Which host reported. One agent today; the column exists so a second box doesn't need a
  /// migration to be visible.
  agentId   String
  createdAt DateTime @default(now())
  /// The whole report as the agent sent it. Deliberately JSON rather than columns: this is
  /// observability data whose shape follows whatever the agent can see, and pinning it to a schema
  /// means a migration every time a new metric is worth reporting.
  payload   Json

  @@index([agentId, id])
  @@index([createdAt])
}

enum OpsCommandStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  /// Never claimed inside its window. A restart that was requested twenty minutes ago and only
  /// now reached a returning agent is almost never still what anyone wants.
  EXPIRED
}

model OpsCommand {
  id            String           @id @default(cuid())
  agentId       String
  /// Validated against an allowlist twice: once here, and again in the agent, which does not trust
  /// this record.
  action        String
  target        String
  status        OpsCommandStatus @default(QUEUED)
  requestedById String?
  claimedAt     DateTime?
  finishedAt    DateTime?
  result        String?          @db.VarChar(2000)
  createdAt     DateTime         @default(now())

  requestedBy User? @relation("OpsCommandRequester", fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([agentId, status])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------------------------
// Addons.
//
// An addon is a MANIFEST, not code. That is the whole design decision and it is not a limitation
// I'm apologising for: the alternative the feature request implies — "any CLI can publish an
// addon and the server runs it" — is remote code execution offered as a product feature. Every
// self-hosted platform that has shipped that has shipped a botnet.
//
// So an addon declares *what* should happen from a fixed vocabulary of triggers, conditions and
// actions, and the interpreter that carries it out lives here, in the server, under the same
// permission checks as a human doing the same thing. There is no eval, no sandbox to escape, and
// no network access an addon can reach for — because there is nowhere in the manifest to express
// any of those things.
//
// Behaviour that genuinely needs code already has a home: bots (a real User with a token) and
// webhooks. Addons cover the large middle ground those make you write a whole service for.
// ---------------------------------------------------------------------------------------------

model Addon {
  id            String   @id @default(cuid())
  /// Stable public identifier, the thing a CLI publishes against. Immutable once created.
  slug          String   @unique
  name          String   @db.VarChar(80)
  description   String?  @db.VarChar(300)
  version       String   @db.VarChar(32)
  /// Validated against modules/addons/manifest.ts on every write. Stored as JSON because it IS a
  /// document — modelling triggers and actions relationally would mean a migration for every new
  /// action type and would still be reassembled into this shape to run.
  manifest      Json
  /// Who may publish a new version. An addon published through the CLI belongs to an Application,
  /// which is what the CLI authenticates as; one created in the UI belongs to a user.
  authorId      String?
  applicationId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  author      User?         @relation("AddonAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  application Application?  @relation("AddonApplication", fields: [applicationId], references: [id], onDelete: SetNull)
  installs    ServerAddon[]

  @@index([applicationId])
}

model ServerAddon {
  id            String   @id @default(cuid())
  serverId      String
  addonId       String
  enabled       Boolean  @default(true)
  installedById String?
  createdAt     DateTime @default(now())

  server      Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  addon       Addon  @relation(fields: [addonId], references: [id], onDelete: Cascade)
  installedBy User?  @relation("AddonInstaller", fields: [installedById], references: [id], onDelete: SetNull)

  /// One install per server. Installing twice is a no-op, not two sets of automations firing.
  @@unique([serverId, addonId])
  @@index([serverId, enabled])
}

// ---------------------------------------------------------------------------------------------
// Self-serve advertising: promoted videos in the For You feed.
//
// Product decisions made deliberately, since each one has a worse alternative:
//
// **The unit is a video already in the feed**, not a new creative format. An advertiser promotes
// something they have already uploaded and a moderator has already approved, which means ad
// creative inherits the entire existing review pipeline instead of needing a second one — and a
// "sponsored" card is the same component as an organic card, so it can never look like a
// different, ignorable widget.
//
// **CPM, not CPC.** Click attribution needs redirect infrastructure, click fraud handling, and an
// argument about what counts as a click on a video. Impressions are already counted honestly for
// the organic feed, so pricing on them reuses machinery that exists and is understood.
//
// **Budget is recorded, never charged here.** Spend accrues against the campaign as it delivers;
// actually collecting it is Stripe's job (task #86). Keeping the ledger separate from the payment
// processor means delivery is correct and auditable whether or not billing is switched on, and
// a campaign that has spent money it hasn't paid for is visible rather than silently free.
// ---------------------------------------------------------------------------------------------

/// Whether an advertiser has actually paid for a campaign.
///
/// Deliberately separate from AdCampaignStatus rather than folded into it as extra states. The two
/// answer different questions — "is this creative allowed to run" (a moderation decision, made by
/// staff) and "has this been paid for" (a payment fact, made by Stripe) — and a campaign can be
/// approved-and-unpaid or paid-and-paused. Collapsing them would make every delivery query have to
/// re-derive one from the other.
enum AdFundingStatus {
  /// Approved but not yet paid for. Does not deliver.
  UNFUNDED
  /// A Checkout session is open. Still does not deliver — an abandoned checkout must never serve.
  PENDING
  FUNDED
  /// Paid and refunded. Terminal; delivery stops.
  REFUNDED
}

enum AdCampaignStatus {
  DRAFT
  PENDING_REVIEW
  /// Reviewed and allowed to deliver. Whether it IS delivering depends on dates and budget, which
  /// are evaluated per request rather than stored — a status that has to be swept by a cron to
  /// stay truthful is a status that is regularly wrong.
  APPROVED
  REJECTED
  PAUSED
  /// Budget exhausted or the end date passed. Terminal, set when delivery notices.
  COMPLETED
}

model AdCampaign {
  id           String           @id @default(cuid())
  advertiserId String?
  /// The video being promoted. Must be APPROVED and belong to the advertiser — checked on create
  /// and re-checked at delivery, because a video can be taken down after a campaign is approved.
  videoId      BigInt?
  name         String           @db.VarChar(100)
  status       AdCampaignStatus @default(DRAFT)

  /// Price per thousand impressions, in the smallest currency unit. Integer cents throughout —
  /// money in floats is how ledgers stop reconciling.
  cpmCents         Int
  totalBudgetCents Int
  /// Accrued delivery cost. Never exceeds totalBudgetCents: delivery stops at the cap.
  spentCents       Int @default(0)

  /// ---- payment ----------------------------------------------------------------------------
  /// Campaigns are PREPAID, and paid only AFTER staff approval. Charging on submission would mean
  /// taking money for creative that may then be rejected, and every rejection would become a
  /// refund; approving first means the platform never holds money for an ad it won't run.
  ///
  /// Because delivery already stops at `totalBudgetCents`, a prepaid balance maps exactly onto the
  /// existing draw-down — no second ledger, and no way to deliver more than was paid for.
  fundingStatus   AdFundingStatus @default(UNFUNDED)
  /// What was actually collected, from the Stripe session rather than from the requested budget:
  /// the two can differ if a budget is ever edited between checkout and payment.
  paidCents       Int             @default(0)
  /// Unique so a redelivered `checkout.session.completed` — normal Stripe behaviour, not an edge
  /// case — cannot fund the same campaign twice.
  stripeSessionId String?         @unique
  paidAt          DateTime?

  startsAt   DateTime
  endsAt     DateTime
  /// Optional tag targeting. Empty means everyone — narrow targeting on an instance this size
  /// would mostly mean not delivering at all.
  targetTags String[] @default([])

  impressionCount Int @default(0)
  clickCount      Int @default(0)

  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?   @db.VarChar(300)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  advertiser User?             @relation("AdAdvertiser", fields: [advertiserId], references: [id], onDelete: SetNull)
  video      Video?            @relation("AdVideo", fields: [videoId], references: [id], onDelete: SetNull)
  reviewedBy User?             @relation("AdReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  daily      AdCampaignDaily[]

  /// The delivery query: eligible campaigns by status and window.
  @@index([status, startsAt, endsAt])
  @@index([advertiserId, createdAt])
}

/// Per-day rollup, written by delivery. Deliberately NOT a row per impression: that is unbounded
/// growth for data nobody reads at that resolution — the same reasoning that keeps video views as
/// a counter rather than a table.
model AdCampaignDaily {
  id          String   @id @default(cuid())
  campaignId  String
  /// Midnight UTC of the day being counted.
  day         DateTime
  impressions Int      @default(0)
  clicks      Int      @default(0)
  spentCents  Int      @default(0)

  campaign AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, day])
  @@index([day])
}

/// Per-day, per-video view rollup — the weight source for daily revenue-pool allocation. Written
/// beside the global viewCount increment under the same Redis dedupe, so a "view" means the same
/// thing to the counter a user sees and to the pool a creator is paid from.
model VideoViewDay {
  id      String   @id @default(cuid())
  videoId BigInt
  /// Midnight UTC of the day counted, matching AdCampaignDaily.day.
  day     DateTime
  views   Int      @default(0)

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, day])
  @@index([day])
}

enum PoolRunStatus {
  POSTED
  EMPTY_POOL
  NO_QUALIFIED_VIEWS
}

/// Completion marker + audit line for one daily pool allocation. The per-creator postings carry
/// their own idempotency keys, so a crashed sweep re-runs safely; this row exists so a completed
/// day is never allocated twice and "what did the pool pay on day D" is one lookup.
model PoolRun {
  id            String        @id @default(cuid())
  product       String
  day           DateTime
  poolMinor     BigInt
  currency      String        @default("usd") @db.VarChar(3)
  status        PoolRunStatus
  creatorCount  Int           @default(0)
  /// Integer-division residue from allocation — units the pool could not hand out evenly.
  /// Recorded rather than silently absorbed, per the visible-residual rule the ledger follows.
  residualMinor BigInt        @default(0)
  createdAt     DateTime      @default(now())

  @@unique([product, day])
}

/// One single-use recovery code for an account with 2FA enabled.
///
/// A row per code rather than an array column, so "mark this one used" is a single write that
/// cannot race with another login consuming a different code — and so the count remaining is a
/// query rather than something the application has to keep in step.
model TotpBackupCode {
  id        String    @id @default(cuid())
  userId    String
  /// Argon2 hash. The plaintext is shown to the user exactly once, at enrolment.
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A WebAuthn credential — a passkey held by the device's secure hardware.
///
/// Nothing secret lives here: the public key is, by design, public. The private half never leaves
/// the authenticator (Secure Enclave, TPM, Android StrongBox), which is what makes this stronger
/// than any password the server could store — there is no shared secret to steal from a dump.
model Passkey {
  /// The credential ID the authenticator returns, base64url. Also the lookup key at sign-in.
  id         String    @id
  userId     String
  publicKey  Bytes
  /// Replay guard. Authenticators increment this per assertion; a counter that goes BACKWARDS means
  /// the credential has been cloned, and the sign-in is refused. Some authenticators (notably Apple)
  /// always report 0, so a zero counter is exempt rather than treated as an attack.
  counter    BigInt    @default(0)
  /// "platform" (Face ID, Windows Hello, fingerprint) or "cross-platform" (a security key).
  deviceType String?
  /// Whether the credential is synced to a cloud keychain, which decides whether losing the device
  /// loses the passkey — worth showing the user before it is their only way in.
  backedUp   Boolean   @default(false)
  transports String?
  /// Free text the user can edit, so a list of four passkeys is distinguishable.
  label      String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A per-server automated moderation rule.
///
/// v1 is keyword matching that BLOCKS the send, and nothing else. Deliberately narrow: a rule
/// engine that can also timeout, delete, log and notify is four features whose interactions have to
/// be reasoned about, and the one that actually stops the message is the one worth having first.
model AutoModRule {
  id            String        @id @default(cuid())
  serverId      String
  name          String        @db.VarChar(80)
  /// Lowercased match terms. Stored as rows rather than a delimited string so a term containing a
  /// comma is not silently split into two.
  terms         AutoModTerm[]
  /// Whole-word matching. Off by default, because the common case ("no slurs") wants substring
  /// matching, and on for the cases where it would otherwise catch innocent words containing the
  /// term — the Scunthorpe problem, which is a real support burden rather than a joke.
  wholeWord     Boolean       @default(false)
  enabled       Boolean       @default(true)
  /// Roles exempt from this rule — moderators discussing a term they are moderating should not be
  /// blocked by it.
  exemptRoleIds String[]      @default([])
  createdById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, enabled])
}

model AutoModTerm {
  id     String      @id @default(cuid())
  ruleId String
  /// Always stored lowercased; matching lowercases the message too.
  term   String      @db.VarChar(120)
  rule   AutoModRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
}

// ---- Store -------------------------------------------------------------------------------------
//
// Lumina sells first-party cosmetics for an in-app currency ("sparks"). Two deliberate choices:
//
// 1. **Coins, not per-item card charges.** Card processing is roughly 2.9% + $0.30, so a $1.99
//    item loses ~18% to fees. Selling a bundle once and spending it many times moves that fixed
//    $0.30 off every purchase and onto every tenth one. Stripe's restricted-business list permits
//    in-app currency where "the business is the operator of the virtual world", which is us.
//
// 2. **Nothing here pays a third party.** Every item is first-party: no creator revenue share, no
//    payouts. Stripe classifies platforms that let creators take tips or sell their own content as
//    a RESTRICTED business needing pre-approval, and Connect onboarding is a much larger build.
//    Keeping the store first-party sidesteps both until there is revenue to justify them.

enum StoreItemKind {
  THEME
  ACCENT
  BADGE
  PROFILE_EFFECT
}

enum CoinReason {
  PURCHASE_BUNDLE
  SPEND_STORE
  GIFT_SEND
  PROMO_GRANT
  ADMIN_ADJUST
  REFUND
}

model StoreItem {
  id          String        @id @default(cuid())
  /// Stable identifier used in code and seeds. Renaming a display name must never orphan a grant.
  sku         String        @unique
  kind        StoreItemKind
  name        String
  description String
  /// What the item actually unlocks - e.g. { "theme": "nebula" }. JSON because each kind carries a
  /// different shape, and modelling four near-empty tables relationally buys nothing.
  payload     Json
  priceCoins  Int
  /// Withdrawn items stay in the table forever: existing grants must keep resolving.
  active      Boolean       @default(true)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  grants      StoreGrant[]

  @@index([active, sortOrder])
}

model StoreGrant {
  id         String    @id @default(cuid())
  userId     String
  itemId     String
  acquiredAt DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  item       StoreItem @relation(fields: [itemId], references: [id])

  /// Ownership is binary, so this both prevents buying the same item twice and makes the purchase
  /// transaction safe against a double-submitted request.
  @@unique([userId, itemId])
  @@index([userId])
}

/// Append-only. Balance is the SUM of a user's entries, never a mutable column - a stored balance
/// invites lost updates under concurrency, and money-adjacent state should be reconstructible.
model CoinLedgerEntry {
  id        BigInt     @id @default(autoincrement())
  userId    String
  /// Positive credits, negative debits.
  delta     Int
  reason    CoinReason
  /// Idempotency key. For a Stripe top-up this is the checkout session id, and the unique index is
  /// what stops a redelivered webhook crediting the same payment twice - Stripe retries on any
  /// non-2xx, so redelivery is normal operation, not an edge case.
  refId     String?    @unique
  note      String?
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Server-uploaded emoji, usable as `:name:` in messages and as a reaction.
///
/// `name` is unique per server, not globally: two servers can both have `:blob:` and a member of
/// both sees the right one in each. Resolution is therefore always server-scoped — see
/// messages/customEmoji.ts, which is why a `:name:` in a DM cannot resolve to a server emoji.
model CustomEmoji {
  id         String     @id @default(cuid())
  serverId   String
  /// Lowercase letters, numbers and underscores, 2-32 chars. Matches Discord so muscle memory and
  /// copied message text both work.
  name       String
  imageUrl   String
  /// Animated emoji render as the original GIF; static ones are re-encoded. Stored rather than
  /// sniffed at render time so a client never has to fetch the image to know how to display it.
  animated   Boolean    @default(false)
  uploaderId String?
  createdAt  DateTime   @default(now())
  server     Server     @relation(fields: [serverId], references: [id], onDelete: Cascade)
  uploader   User?      @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  reactions  Reaction[]

  @@unique([serverId, name])
  @@index([serverId])
}

// ---------------------------------------------------------------------------
// Stickers
// ---------------------------------------------------------------------------

/// A server-scoped image sent *as* a message rather than inside one.
///
/// Deliberately a separate model from CustomEmoji even though the upload path is nearly identical.
/// They differ in the one way that matters: an emoji is inline text that resolves by `:name:` and
/// can be reacted with, a sticker is a whole message body addressed by id. Folding them together
/// would mean a `kind` column that every query then has to filter on, and a Reaction FK that is
/// meaningless for half the rows.
model Sticker {
  id          String    @id @default(cuid())
  serverId    String
  /// 2-32 chars. Looser than an emoji name (spaces allowed) because a sticker is never typed as
  /// `:name:` — it is picked from a grid, so there is no syntax to keep clean.
  name        String
  description String?
  imageUrl    String
  /// GIF stickers keep their animation; everything else is re-encoded. Same reasoning as
  /// CustomEmoji.animated — stored so a client never has to fetch the image to know how to show it.
  animated    Boolean   @default(false)
  uploaderId  String?
  createdAt   DateTime  @default(now())
  server      Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  uploader    User?     @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  messages    Message[]

  @@unique([serverId, name])
  @@index([serverId])
}

// ---------------------------------------------------------------------------
// Polls
// ---------------------------------------------------------------------------

model Poll {
  id            String       @id @default(cuid())
  question      String
  /// Multi-select polls keep every vote a user casts; single-select ones replace the previous vote
  /// inside a transaction (see modules/polls/service.ts). The constraint that actually enforces
  /// "one vote per option per user" is PollVote's composite id; this flag decides whether the
  /// service clears the others first.
  allowMultiple Boolean      @default(false)
  /// Null means it never closes. A closed poll still shows results, it just refuses new votes.
  expiresAt     DateTime?
  createdAt     DateTime     @default(now())
  options       PollOption[]
  votes         PollVote[]
  messages      Message[]
}

model PollOption {
  id       String     @id @default(cuid())
  pollId   String
  label    String
  /// Display order. Stored rather than relying on insertion order, because "which option is first"
  /// is part of what the author wrote.
  position Int
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes    PollVote[]

  @@index([pollId])
}

model PollVote {
  pollId    String
  optionId  String
  userId    String
  createdAt DateTime   @default(now())
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Keyed on the option, not the poll: a multi-select poll needs one row per chosen option, and
  /// this is what makes double-clicking an option idempotent rather than double-counting.
  @@id([optionId, userId])
  /// Tallying reads every vote in a poll, and so does the "did I already vote" check.
  @@index([pollId, userId])
}

// ---------------------------------------------------------------------------
// Soundboard
// ---------------------------------------------------------------------------

/// A short clip any member in a voice channel can trigger for everyone in it.
///
/// No media server is involved: the file is served over HTTP like any other upload, and playback is
/// a Socket.IO event relayed to the voice room (realtime/handlers/voice.ts) that each client
/// answers by playing the clip locally. That is the same "signaling only" shape the mesh voice
/// implementation already has — mixing audio server-side would mean becoming an SFU.
model SoundboardSound {
  id         String   @id @default(cuid())
  serverId   String
  name       String
  audioUrl   String
  /// Optional single emoji shown on the button, purely cosmetic.
  emoji      String?
  durationMs Int
  sizeBytes  Int
  uploaderId String?
  createdAt  DateTime @default(now())
  server     Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  uploader   User?    @relation(fields: [uploaderId], references: [id], onDelete: SetNull)

  @@unique([serverId, name])
  @@index([serverId])
}

// ---------------------------------------------------------------------------
// Link previews
// ---------------------------------------------------------------------------

enum LinkPreviewStatus {
  /// Queued but not fetched yet — the row exists so two messages posting the same link at once
  /// cannot both start a fetch.
  PENDING
  OK
  /// Fetched and deliberately produced nothing renderable (no OG tags, wrong content type). Cached
  /// as a negative result so a link that will never have a preview is not refetched on every post.
  EMPTY
  /// Refused before any request left the process — private/loopback/link-local target. Kept
  /// distinct from FAILED because it is the security path and wants to be greppable in isolation.
  BLOCKED
  FAILED
}

/// One cached unfurl per URL, shared by every message that links it.
model LinkPreview {
  id          String            @id @default(cuid())
  /// SHA-256 of the normalized URL, not the URL itself: Postgres btree keys top out around 2704
  /// bytes and URLs have no such limit, so a unique index on the raw string is a latent 500.
  urlHash     String            @unique
  url         String
  status      LinkPreviewStatus @default(PENDING)
  title       String?
  description String?
  imageUrl    String?
  siteName    String?
  /// Why a BLOCKED/FAILED row failed. Not shown to users — this is for the operator reading logs.
  failReason  String?
  fetchedAt   DateTime?
  createdAt   DateTime          @default(now())
  messages    MessageEmbed[]

  /// Refresh sweeps read the oldest rows first.
  @@index([fetchedAt])
}

/// Join table: a message with three links gets three embeds, in the order they appeared.
model MessageEmbed {
  messageId BigInt
  previewId String
  position  Int
  message   Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  preview   LinkPreview @relation(fields: [previewId], references: [id], onDelete: Cascade)

  @@id([messageId, previewId])
  @@index([previewId])
}

// ---------------------------------------------------------------------------
// Slash commands and interactions
// ---------------------------------------------------------------------------

model SlashCommand {
  id            String      @id @default(cuid())
  applicationId String
  /// Lowercase, 1-32 chars, no spaces — this is what a user types after `/`.
  name          String
  description   String
  /// The option list, verbatim as the bot registered it. JSON rather than a relational option
  /// table for the same reason Discord does it: options nest (subcommand groups contain
  /// subcommands contain options), and modelling a tree relationally buys nothing here because
  /// nothing ever queries *into* it — it is read whole, by one client, to draw a form.
  optionsJson   Json        @default("[]")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, name])
  @@index([applicationId])
}

enum InteractionType {
  COMMAND
  COMPONENT
}

enum InteractionStatus {
  PENDING
  RESPONDED
  /// The bot did not answer inside RESPONSE_WINDOW_MS. Recorded rather than deleted so a bot
  /// author can see their own timeouts.
  TIMED_OUT
}

/// One user action awaiting a bot's reply — a slash command invocation or a component click.
///
/// Persisted rather than held in memory because the process that receives the click and the
/// process that receives the bot's response are not guaranteed to be the same one: the API runs
/// behind a socket adapter and can be scaled to more than one container.
model Interaction {
  id                String            @id @default(cuid())
  applicationId     String
  type              InteractionType
  status            InteractionStatus @default(PENDING)
  userId            String
  channelId         String?
  dmConversationId  String?
  serverId          String?
  /// COMMAND only.
  commandName       String?
  optionsJson       Json?
  /// COMPONENT only — the customId the bot put on the button, and the message it was attached to.
  componentCustomId String?
  messageId         BigInt?
  /// The message this interaction's RESPONSE created (vs messageId, the component's source
  /// message). Anchors Discord-compat editReply/fetchReply (@original).
  replyMessageId    BigInt?
  /// Single-use bearer for the response call. The bot proves it may answer *this* interaction by
  /// holding this, so responding never needs its own permission check against the channel.
  token             String            @unique
  respondedAt       DateTime?
  createdAt         DateTime          @default(now())
  application       Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  /// The sweep that expires stale PENDING rows.
  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Server templates
// ---------------------------------------------------------------------------

/// A frozen copy of a server's channel/category/role structure, replayable into a new server.
///
/// snapshotJson holds the whole structure rather than a relational mirror of Channel/Role, and that
/// is on purpose: a template must keep describing the shape it was taken from even after the source
/// server renames its channels, deletes roles, or is deleted outright. A relational copy would
/// either drift with the original or need every one of those tables duplicated.
model ServerTemplate {
  id             String   @id @default(cuid())
  /// Shareable code in the URL. Shares no namespace with invites — a template is not joinable.
  code           String   @unique
  name           String
  description    String?
  creatorId      String?
  /// Null once the source server is gone; the snapshot outlives it deliberately.
  sourceServerId String?
  snapshotJson   Json
  uses           Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  creator        User?    @relation("TemplateCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  sourceServer   Server?  @relation("TemplateSource", fields: [sourceServerId], references: [id], onDelete: SetNull)

  @@index([creatorId])
  @@index([sourceServerId])
}

enum ParentLinkStatus {
  PENDING
  ACTIVE
  REVOKED
}

/**
 * The link between a minor account and the adult responsible for it.
 *
 * A minor account is created immediately but is INERT until an adult accepts this link — it cannot
 * message, join servers, hold friends, or be seen by anyone. That is the operator's chosen posture
 * and it is enforced server-side (see modules/parental/guard.ts), not by hiding buttons: a locked
 * minor with a stolen token still cannot do any of those things.
 *
 * `childUserId` is unique — exactly one responsible adult, never a committee. A second adult
 * wanting oversight has to replace the first, which keeps "who is accountable for this account"
 * answerable with a single row.
 *
 * `parentUserId` stays null until the code is redeemed, so a PENDING link names no adult and
 * cannot be used to imply one consented.
 */
model ParentLink {
  id           String           @id @default(cuid())
  childUserId  String           @unique
  parentUserId String?
  status       ParentLinkStatus @default(PENDING)
  /// Short, human-transcribable code the child hands to their parent out of band. Unique so
  /// redemption is an exact lookup and never has to guess between two links.
  pairingCode  String           @unique
  createdAt    DateTime         @default(now())
  acceptedAt   DateTime?
  revokedAt    DateTime?

  child            User                    @relation("ChildOfLink", fields: [childUserId], references: [id], onDelete: Cascade)
  parent           User?                   @relation("ParentOfLink", fields: [parentUserId], references: [id], onDelete: SetNull)
  approvedContacts ParentApprovedContact[]

  @@index([parentUserId])
  @@index([status])
}

/**
 * An adult the parent has cleared to contact THIS child specifically.
 *
 * Hung off the ParentLink rather than off the child's User row so the scope is structural: an
 * approval is meaningless outside the link that created it, and one parent's decision about their
 * own child can never widen into permission to contact any other minor on the platform. That is
 * the whole safety property of this table, and the FK is what enforces it rather than a WHERE
 * clause someone might forget.
 */
model ParentApprovedContact {
  id             String   @id @default(cuid())
  parentLinkId   String
  approvedUserId String
  /// Why the parent allowed this person — their own note (an aunt, a school friend's parent).
  /// Kept because a bare username list becomes unreviewable within a month.
  note           String?  @db.VarChar(200)
  createdAt      DateTime @default(now())

  parentLink   ParentLink @relation(fields: [parentLinkId], references: [id], onDelete: Cascade)
  approvedUser User       @relation("ApprovedForMinor", fields: [approvedUserId], references: [id], onDelete: Cascade)

  @@unique([parentLinkId, approvedUserId])
  @@index([approvedUserId])
}

enum GameProvider {
  MINECRAFT
}

/**
 * A game identity attached to a Lumina account.
 *
 * One row per (user, provider). `externalId` is the game's own stable id (Minecraft: the profile
 * UUID) — usernames rename, UUIDs do not, so the UUID is the identity and the name is a cached
 * display value refreshed on relink.
 *
 * `verified` distinguishes "claimed" from "proven". Anyone can type any Minecraft username; proof
 * happens in-game: a server plugin (any owner's, via the documented bot-token API) submits the
 * user's `verifyCode` together with the UUID it observed the player using. Claimed-but-unverified
 * links still render — a skin on a profile is decoration — but anything that TRUSTS the identity
 * must check `verified`.
 */
model GameLink {
  id           String       @id @default(cuid())
  userId       String
  provider     GameProvider
  externalId   String
  externalName String
  /// Local path under /game-skins — the upstream texture is cached to our own origin at link time
  /// so profiles never hotlink a third party (CSP, availability, and privacy all say no).
  skinPath     String?
  verified     Boolean      @default(false)
  verifyCode   String       @unique
  createdAt    DateTime     @default(now())
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([provider, externalId])
}

/**
 * An embeddable app a developer attaches to their dev-portal Application — Lumina's equivalent of
 * Discord Activities. Launched docked beside a channel in a sandboxed iframe; the client hands it
 * an origin-targeted identity handshake (see frontend ActivityFrame) and nothing else. It never
 * receives a token it didn't obtain itself through the existing OAuth2 flow.
 *
 * `url` is https-only by validation: an activity is third-party code every launcher's browser will
 * load, and a plaintext embed would be an injection point on every machine that opens it.
 */
model Activity {
  id            String      @id @default(cuid())
  applicationId String
  name          String      @db.VarChar(80)
  description   String?     @db.VarChar(300)
  url           String      @db.VarChar(500)
  iconUrl       String?
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

// ================================================================ retention: inbox + XP

enum NotificationKind {
  REPLY
  REACTION
  VIDEO_LIKE
  VIDEO_COMMENT
  THREAD
  FRIEND_ACCEPT
  LEVEL_UP
  EARNING
  EVENT_REMINDER
}

/**
 * The unified Activity inbox. One row per (recipient, kind, target) — repeat actors on the same
 * target BUNDLE into the row (actorCount, latest actor) rather than stacking twenty rows for
 * twenty reactions, because an inbox that scrolls is read and an inbox that floods is muted.
 */
model Notification {
  id         BigInt           @id @default(autoincrement())
  userId     String
  kind       NotificationKind
  /// Bundling identity: kind + what it is about, e.g. "REACTION:msg:123".
  bundleKey  String
  actorId    String?
  actorCount Int              @default(1)
  messageId  BigInt?
  channelId  String?
  serverId   String?
  videoId    String?
  /// Short pre-rendered context (message snippet, video caption) so the inbox renders without a
  /// join per row against content that may since be deleted.
  preview    String?          @db.VarChar(140)
  readAt     DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  user       User             @relation("InboxOwner", fields: [userId], references: [id], onDelete: Cascade)
  actor      User?            @relation("InboxActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([userId, bundleKey])
  @@index([userId, readAt, updatedAt])
}

/**
 * Per-server participation XP — the native version of what Discord's community ran Mee6 for.
 * Earned by messages on a cooldown (so spam is worthless), never purchasable, never decaying:
 * levels rank what someone DID, they are not a streak that punishes absence.
 */
model MemberXp {
  userId      String
  serverId    String
  xp          Int      @default(0)
  level       Int      @default(0)
  lastAwardAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@id([userId, serverId])
  @@index([serverId, xp])
}

/// A role granted automatically at a level. The reward is real authority/cosmetics via the
/// EXISTING role system — no parallel perk machinery.
model LevelReward {
  id       String @id @default(cuid())
  serverId String
  level    Int
  roleId   String
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  role     Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([serverId, level, roleId])
}

// ================================================================ creator economy

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum RevenueEventStatus {
  RECEIVED
  QUALIFIED
  EXCLUDED
  POSTED
}

enum EarningStatus {
  PENDING
  AVAILABLE
  REVERSED
  PAID
}

enum CreatorProgramState {
  NOT_ELIGIBLE
  LIMITED
  CREATOR
  SUSPENDED
  PAYOUT_RESTRICTED
}

enum PayoutState {
  NOT_READY
  PENDING_KYC
  AVAILABLE
  SCHEDULED
  SUBMITTED
  PAID
  FAILED
  REVERSED
}

/**
 * Double-entry ledger — the financial source of truth.
 *
 * Balances are never stored authoritatively anywhere else: CreatorWallet below is a READ MODEL
 * maintained in the same transaction as the entries that change it, and reconciliation re-derives
 * it from entries to prove it. History is append-only; there is no update path in code, and
 * corrections are reversing transactions. Money is integer minor units + ISO currency, always.
 *
 * Per-creator positions live as entries against CONTROL accounts (CREATOR_PENDING,
 * CREATOR_PAYABLE) tagged with subjectUserId — the standard control/subledger shape, which keeps
 * the chart of accounts finite while every creator's balance stays derivable.
 */
model LedgerTransaction {
  id             String        @id @default(cuid())
  kind           String
  /// The idempotency spine: replaying any upstream event reuses this key and posts nothing twice.
  idempotencyKey String        @unique
  externalRef    String?       @unique
  occurredAt     DateTime
  postedAt       DateTime      @default(now())
  metadata       Json?
  entries        LedgerEntry[]
}

model LedgerEntry {
  id            BigInt            @id @default(autoincrement())
  transactionId String
  accountCode   String
  direction     LedgerDirection
  amountMinor   BigInt
  currency      String            @db.VarChar(3)
  /// Which creator/user this control-account entry belongs to, when the account is a subledger.
  subjectUserId String?
  contentRef    String?
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([accountCode, subjectUserId])
  @@index([transactionId])
}

/// Normalized envelope every monetized thing flows through before it may touch the ledger.
model RevenueEvent {
  id             String             @id @default(cuid())
  eventType      String
  idempotencyKey String             @unique
  source         String
  status         RevenueEventStatus @default(RECEIVED)
  occurredAt     DateTime
  receivedAt     DateTime           @default(now())
  currency       String             @db.VarChar(3)
  grossMinor     BigInt
  userId         String?
  creatorId      String?
  contentRef     String?
  externalRef    String?
  riskContext    Json?
  excludedReason String?
  ledgerTxId     String?
  policyVersion  Int?

  @@index([creatorId, occurredAt])
  @@index([status])
}

/**
 * Versioned, effective-dated split policy. Basis-points, never floats. Economics are DATA with
 * history, not constants scattered through services — §1.3's "never self-modify financial policy"
 * is enforced by these rows being written only through owner tooling and never by jobs.
 */
model RevenuePolicy {
  id            String    @id @default(cuid())
  product       String
  version       Int
  creatorBps    Int
  platformBps   Int
  holdDays      Int
  reserveBps    Int       @default(0)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  notes         String?

  @@unique([product, version])
  @@index([product, effectiveFrom])
}

/// Read model over the ledger, per creator. Proven against entries by reconciliation.
model CreatorWallet {
  userId        String   @id
  currency      String   @default("usd") @db.VarChar(3)
  pendingMinor  BigInt   @default(0)
  availableMinor BigInt  @default(0)
  reservedMinor BigInt   @default(0)
  paidMinor     BigInt   @default(0)
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// One creator-earning line a person can point at: which event, how much, when it unlocks.
model EarningItem {
  id             String        @id @default(cuid())
  creatorId      String
  revenueEventId String        @unique
  product        String
  amountMinor    BigInt
  currency       String        @db.VarChar(3)
  status         EarningStatus @default(PENDING)
  availableAt    DateTime
  policyVersion  Int
  createdAt      DateTime      @default(now())
  creator        User          @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId, status])
  @@index([status, availableAt])
}

model CreatorProgram {
  userId       String              @id
  state        CreatorProgramState @default(NOT_ELIGIBLE)
  /// Machine-readable requirement snapshot from the last evaluation, rendered as the creator's
  /// progress checklist — the same data decides and explains, so the two cannot disagree.
  requirements Json?
  evaluatedAt  DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([state])
}

model PayoutAccount {
  userId          String   @id
  provider        String   @default("stripe")
  providerAccount String?  @unique
  onboarded       Boolean  @default(false)
  payoutsEnabled  Boolean  @default(false)
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payout {
  id             String      @id @default(cuid())
  creatorId      String
  amountMinor    BigInt
  currency       String      @db.VarChar(3)
  state          PayoutState @default(NOT_READY)
  idempotencyKey String      @unique
  externalRef    String?     @unique
  failureReason  String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  creator        User        @relation(fields: [creatorId], references: [id], onDelete: Restrict)

  @@index([creatorId, state])
}

/// The gift catalogue — coins in, creator fiat earnings out, per policy.
model Gift {
  id         String  @id @default(cuid())
  key        String  @unique
  name       String
  emoji      String
  priceCoins Int
  active     Boolean @default(true)
  sortOrder  Int     @default(0)
  sends      GiftSend[]
}

model GiftSend {
  id             String   @id @default(cuid())
  giftId         String
  senderId       String
  creatorId      String
  contentRef     String?
  priceCoins     Int
  revenueEventId String?  @unique
  createdAt      DateTime @default(now())
  gift           Gift     @relation(fields: [giftId], references: [id], onDelete: Restrict)
  sender         User     @relation("GiftsSent", fields: [senderId], references: [id], onDelete: Cascade)
  creator        User     @relation("GiftsReceived", fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId, createdAt])
}
