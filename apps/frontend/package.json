{
  "name": "@lumina/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . --noEmit && vite build",
    "build:mobile": "tsc -p . --noEmit && vite build --mode mobile",
    "build:desktop": "tsc -p . --noEmit && vite build --mode desktop --outDir dist-desktop",
    "preview": "vite preview",
    "typecheck": "tsc -p . --noEmit",
    "build:owner": "tsc -p . --noEmit && APP_VARIANT=owner vite build --mode owner && cp dist-owner/owner.html dist-owner/index.html"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@capacitor/preferences": "^8.0.1",
    "@lumina/shared": "*",
    "@noble/ciphers": "^2.3.0",
    "@noble/curves": "^2.3.0",
    "@noble/hashes": "^2.3.0",
    "@noble/post-quantum": "^0.7.0",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-context-menu": "^2.2.6",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@simplewebauthn/browser": "^13.3.0",
    "@tanstack/react-query": "^5.66.0",
    "@types/qrcode": "^1.5.6",
    "dompurify": "^3.2.4",
    "lucide-react": "^0.474.0",
    "marked": "^15.0.6",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.5",
    "socket.io-client": "^4.8.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.62.1",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
