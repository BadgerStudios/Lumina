# Owner Android build. A Capacitor WebView's origin (capacitor://localhost) shares nothing with the
# API's real origin, so root-relative "/api" would resolve against the wrong host — the absolute URL
# is required here exactly as it is for the normal mobile build.
VITE_API_BASE_URL=https://lumina.badgerstudios.net/api
VITE_SOCKET_URL=https://lumina.badgerstudios.net
# CLIENT_TYPE=mobile makes the API return the refresh token in the response body instead of an
# httpOnly cookie (see modules/auth/service.ts) — a WebView has no usable cookie jar for this.
VITE_CLIENT_TYPE=mobile
VITE_APP_BUILD=29
# Which app this bundle is, so the updater compares itself against lumina-owner.apk rather than the
# chat app's APK (see queries/meta.ts). The two are different applicationIds — downloading the wrong
# one passes the checksum check and is then refused by the OS at install time.
VITE_APP_VARIANT=owner
