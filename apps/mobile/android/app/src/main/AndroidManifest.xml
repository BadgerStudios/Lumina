<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links: emailed password-reset / verify-email links and shared invites open
                 IN the app instead of the browser. Three parts have to agree or the whole thing
                 silently degrades to the browser:
                   1. these host+path claims,
                   2. the allowlists in frontend src/components/common/DeepLinkHandler.tsx
                      (which turns the received URL into router navigation — without it the app
                      opens and the link is dropped, which was the original reset-flow bug),
                   3. /.well-known/assetlinks.json on BOTH hosts, which must list the SHA-256 of
                      the cert this APK is signed with (autoVerify makes Android check it).
                 <data> elements union: any listed host x any listed path matches. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="lumina.badgerstudios.net" />
                <data android:host="lumina.luxffa.com" />
                <data android:path="/reset-password" />
                <data android:path="/verify-email" />
                <data android:pathPrefix="/invite/" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lumina is sideloaded rather than distributed through Play, so in-app updating means
         launching the system package installer ourselves (see AppUpdaterPlugin). Without this the
         install intent is refused by the OS with nothing shown to the user. The user still
         confirms every install; this permission only allows the app to *ask*. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
