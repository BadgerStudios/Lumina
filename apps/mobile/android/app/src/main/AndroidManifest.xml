<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- One receiver for every FCM message: Lumina's own, which rings for incoming calls and
             hands everything else to the push plugin unchanged (LuminaMessagingService). The
             plugin's service is removed so exactly one service answers MESSAGING_EVENT. -->
        <service
            android:name="com.capacitorjs.plugins.pushnotifications.MessagingService"
            tools:node="remove" />
        <service
            android:name=".LuminaMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- Decline on a ringing call silences this phone (CallDeclineReceiver). -->
        <receiver
            android:name=".CallDeclineReceiver"
            android:exported="false" />


        <!-- The status-bar mark and its tint for any notification that does not name its own.
             FCM pushes name ic_stat_notify explicitly (backend lib/fcm.ts); without these two,
             anything else falls back to the launcher icon, which Android flattens into a
             featureless white disc. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notify" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/lumina_notify" />


        <!-- A ringing call on a locked phone (see IncomingCallActivity): shows over the lock screen
             and turns the screen on, and shows only who is calling. Not exported: only the app's
             own full-screen notification opens it. -->
        <activity
            android:name=".IncomingCallActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:taskAffinity="com.luxffa.lumina.call"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links: emailed password-reset / verify-email links and shared invites open
                 IN the app instead of the browser. Three parts have to agree or the whole thing
                 silently degrades to the browser:
                   1. these host+path claims,
                   2. the allowlists in frontend src/components/common/DeepLinkHandler.tsx
                      (which turns the received URL into router navigation — without it the app
                      opens and the link is dropped, which was the original reset-flow bug),
                   3. /.well-known/assetlinks.json on BOTH hosts, which must list the SHA-256 of
                      the cert this APK is signed with (autoVerify makes Android check it).
                 <data> elements union: any listed host x any listed path matches. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="lumina.badgerstudios.net" />
                <data android:host="lumina.luxffa.com" />
                <data android:path="/reset-password" />
                <data android:path="/verify-email" />
                <data android:pathPrefix="/invite/" />
            </intent-filter>

        </activity>

        <!-- Keeps a voice call alive with the screen off or another app in front. Started and
             stopped by VoiceCallPlugin; see VoiceCallService for why a call needs it. -->
        <service
            android:name=".VoiceCallService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- A ringing call lights the screen over the lock screen (CallRinger). Without it the call
         still rings as a heads-up notification. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Sideload builds use the system package installer for in-app updates. The Play-specific
         bundle is built from a temporary manifest without this restricted permission. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Voice rooms, calls, voice messages and camera. The WebView turns getUserMedia into a runtime
         request for these (Capacitor's BridgeWebChromeClient), and Android refuses a permission the
         manifest never declared without ever showing a prompt. Before these lines existed every
         voice join in the app failed on the spot. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- VoiceCallService: a microphone foreground service plus a partial wake lock while in a call. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
</manifest>
